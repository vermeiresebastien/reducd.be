rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Publiek: alleen gepubliceerde posts lezen
    match /posts/{postId} {
      allow read: if resource.data.status == 'published'
        || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Admin-allowlist: document-ID = e-mailadres (lowercase).
    // Verplicht: maak in Console een leeg document aan per admin-e-mail,
    // anders falen create/update/delete op /posts (isAdmin() hierboven).
    match /admins/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email;
      allow write: if false; // alleen via Firebase Console / Admin SDK
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isDistributor() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/distributors/$(emailKey()))
        && get(/databases/$(database)/documents/distributors/$(emailKey())).data.get('active', true) != false;
    }

    match /distributors/{email} {
      allow read: if isAdmin() || (isSignedIn() && emailKey() == email);
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.email == emailKey());
      allow create: if isDistributor()
        && request.resource.data.email == emailKey()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
